  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A sequencing of individual actions to achieve a higher level objective."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#Action_Element"
  } ]
}, {
