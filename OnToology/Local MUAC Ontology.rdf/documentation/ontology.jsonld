}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Support_Product",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "e.g GBS, Tools, Non-Critical Data feeders like DWH"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#Product"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid80"
  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Support_System",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A distinct, structured combination of hardware, software, processes, or personnel that interacts with the Operational System during its lifecycle to enable its availability, reliability, security, or continuous improvement. It does not directly produce the primary operational output (e.g., separating aircraft), but it provides the essential environment, data, or services required for the Operational System to do so."
  }, {
    "@value" : "Core Criteria for a Support System\n\nMission Indirectness: If the support system fails entirely, the Operational System doesn't instantly crash mid-operation, but the organization's ability to maintain, deploy, or legally operate that system degrades immediately.\n\nLifecycle Focus: It often operates on a different rhythm than the real-time operational loop—focusing instead on preparation, maintenance, training, or post-operational analysis.\n\nShared or Dedicated Infrastructure: It can be internal (e.g., a local test bed) or external (e.g., a commercial satellite communications network provider or third-party weather data feed"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#System_Element"
  }, {
    "@id" : "_:genid84"
  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#System_Capability",
