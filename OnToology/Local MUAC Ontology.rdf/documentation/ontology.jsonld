}, {
  "@id" : "http://example.org/muac_onto/Mode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/elements/1.1/source" : [ {
    "@value" : "Wasson, C.S. (2011), 3.3.1 System Phases, Modes, and States: Solutions to Controversial Issues. INCOSE International Symposium, 21: 279-294. https://doi.org/10.1002/j.2334-5837.2011.tb01205.x"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Mode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#Behavioral_Interval"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An abstract label applied to a user selectable option that enables a set of use case-based system capabilities to be employed in conjunction with organizational processes and procedures to command and control (C2) a system, product, or service to achieve a specified set of mission objectives, outcomes, and levels of performance. Triggering events serve as entry and exit\ncriteria for transitioning into and out of a mode. Modes can have sub-modes."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "When a system is in a failed state, the supervisor can make the decision to switch mode of operation from primary to fallback operations. This mode change causes the state of the fallback system to be Operational"
  } ]
}, {
  "@id" : "http://example.org/muac_onto/Phase",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/elements/1.1/source" : [ {
    "@value" : "Wasson, C.S. (2011), 3.3.1 System Phases, Modes, and States: Solutions to Controversial Issues. INCOSE International Symposium, 21: 279-294. https://doi.org/10.1002/j.2334-5837.2011.tb01205.x"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Phase"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#Behavioral_Interval"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A designation applied to segments of the System / Product Life Cycle or Mission Lifecycle of a system, product – e.g., Pre-Mission, Mission, or Post-Mission. Phases may consist of sub-phases – e.g., an aircraft’s Mission Phase of operations may be partitioned into Phases of Flight (subphases) such as take-off, ascent, cruise, or land."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "A flight consists of seven primary phases: preflight, taxi, takeoff, climb, cruise, descent and approach, and landing/roll-out"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Use phase only to describe lifecycle stages of a system, mission/operation i.e time sequencing is relevant"
  } ]
}, {
  "@id" : "http://example.org/muac_onto/State",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/elements/1.1/source" : [ {
    "@value" : "Wasson, C.S. (2011), 3.3.1 System Phases, Modes, and States: Solutions to Controversial Issues. INCOSE International Symposium, 21: 279-294. https://doi.org/10.1002/j.2334-5837.2011.tb01205.x"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "State"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#Behavioral_Interval"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An attribute used to characterize the current logistical employment, status, or performance-base condition of a system, product, or service or system components at the element, subsystem, assembly, subassembly, etc. levels of abstraction. Based on principles of physics, “states” are observable, measurable, verifiable."
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "The state vs phase confusion is large e.g ICAO defines INCERFA, ALERFA as phases. This contradicts definitions of Wasson as  these designations represent condition-based safety or readiness conditions rather than planned, time-based segments of a mission, placing them under the definition of system states."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "A system element is nominal state when it performs its intended functions. Physical failures or changes in its environment can cause it not to perform intended functions or even performed unintended functions then this system element is in a failed state."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@value" : "Usually states are described using past-participle verbs, taxiing, cruising, operating. A flight during its taxi phase is in taxiing state. Phase and state can be confused as there is no discriminator as user control for states vs modes."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Use states to describe the active behavior of system elements or the outcome of their behaviors."
  } ]
}, {
  "@id" : "http://example.org/muac_onto/hasMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://example.org/muac_onto/Phase"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://example.org/muac_onto/Mode"
  } ]
}, {
  "@id" : "http://example.org/muac_onto/hasPhase",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://example.org/muac_onto/Phase"
  } ]
}, {
  "@id" : "http://example.org/muac_onto/hasState",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://example.org/muac_onto/Mode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://example.org/muac_onto/State"
  } ]
}, {
  "@id" : "http://example.org/muac_onto/sequenceNum",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://example.org/muac_onto/Phase"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#int"
  } ]
}, {
  "@id" : "http://purl.org/dc/elements/1.1/source",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Convention for naming relations (Object Properties)\n\n1. The Active-Passive Pattern (most relations)\n* Forward Relation: Active verb in the present tense (e.g., employs, teaches, owns).\n  - Points from the independent entity (Whole), active agent (Actor), or creator to the   dependent entity (Part), passive object (Target), or creation. \n* Reverse Relation: Passive voice or reciprocal verb (e.g., is_employed_by, is_taught_by, is_owned_by).\nExample:\n - Forward: Organization employs Person\n - Reverse: Person is_employed_by Organization\n\n2. The Has-Is-Of Pattern (hiearchical relations)\n* Forward Relation: Starts with has_ to indicate ownership, composition, or property.\n* Reverse Relation: Starts with is_ or ends with _of to point back to the subject.\nExample:\n - Forward: Car has_part Engine\n - Reverse: Engine is_part_of Car\n\nDetermines property direction based on priority: Forward relations point from the independent entity (Whole), active agent (Actor), or creator to the dependent entity (Part), passive object (Target), or creation."
  }, {
    "@value" : "TODO:\n- Capabilities are realized by Flows\n- Function Exchanges are allocated to Structure Exchanges"
  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Action_Block",
