    "@id" : "http://www.example.org/muac/ontology/local-moo#Capability"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid85"
  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#System_Element",
