  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This is docuemented in MIDD"
  }, {
    "@value" : "https://mbse-capella.org/resources/arcadia-reference/Arcadia%20Language%20-%20MetaModel.pdf\nAn ordered set of references to elements routed together, during an interaction or exchange between functions, components and actors. For MUAC this is the MIDD part of the data_flow i.e the communication and control objects?"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
