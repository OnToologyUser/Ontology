  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Data_Class",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Description of an atomic Data Element. Example:\nAircraftPerformance\n- speed : m/s\n- rate_of_climb : m/s\n- thrus_specific_fuel_consumption: g/(s * kN)"
  }, {
    "@value" : "This is documented in ASN.1"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#Data_Model_Element"
  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Data_Model_Element",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents foundational system information entities, resources, or state variables in isolation, independent of their communication or transport mechanisms."
  } ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Desired_Characteristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.example.org/muac/ontology/local-moo#Enterprise_System",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Here definition is based on inverse relation hasPart as it is the highest level, it cannot be part of anything else, or at least for this scope of work."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.example.org/muac/ontology/local-moo#System_Element"
