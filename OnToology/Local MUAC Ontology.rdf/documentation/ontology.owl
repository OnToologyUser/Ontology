    <!-- http://www.example.org/muac/ontology/local-moo#isDirectPartOf -->


    <owl:ObjectProperty rdf:about="http://www.example.org/muac/ontology/local-moo#isDirectPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/muac/ontology/local-moo#isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
