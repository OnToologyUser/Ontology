###  http://www.example.org/muac/ontology/local-moo#Organizational_Element
:Organizational_Element rdf:type owl:Class ;
                        rdfs:subClassOf :Structural_Element ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :isDirectPartOf ;
                                          owl:someValuesFrom :Enterprise_System
                                        ] .


###  http://www.example.org/muac/ontology/local-moo#Organizational_Process
:Organizational_Process rdf:type owl:Class ;
                        rdfs:subClassOf [ owl:intersectionOf ( :Composite_Action_Flow
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :sequencesBlock ;
                                                                 owl:someValuesFrom :Task
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :sequencesBlock ;
                                                                 owl:allValuesFrom [ owl:intersectionOf ( :Task
                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty :isResponsibilityOf ;
                                                                                                            owl:someValuesFrom :Operational_Actor
                                                                                                          ]
                                                                                                        ) ;
                                                                                     rdf:type owl:Class
                                                                                   ]
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                        owl:disjointWith :System_Process ;
                        rdfs:comment """1. It is a composite flow.
2.It must contain at least one business Task (ensuring it isn't an empty process).
3.Crucially, every single block inside it must exclusively be a Task that has a assigned, responsible Operational_Actor attached to it.""" .


###  http://www.example.org/muac/ontology/local-moo#Performance
:Performance rdf:type owl:Class ;
             rdfs:subClassOf :Desired_Characteristic .


