:Shared_Product rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Product
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :isDirectPartOf ;
                                                             owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :Product_System
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Product .


###  http://www.example.org/muac/ontology/local-moo#Structural_Element
:Structural_Element rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :performsAction ;
                                      owl:someValuesFrom :Action_Block
                                    ] .


###  http://www.example.org/muac/ontology/local-moo#Structural_Exchange
:Structural_Exchange rdf:type owl:Class ;
                     rdfs:subClassOf :Atomic_Action_Flow ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasSourceStructure ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Structural_Element
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasTargetStructure ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Structural_Element
                                     ] .


###  http://www.example.org/muac/ontology/local-moo#Support_Product
:Support_Product rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Product
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :isDirectPartOf ;
                                                              owl:someValuesFrom :Support_System
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :Product ;
                 rdfs:comment "e.g GBS, Tools, Non-Critical Data feeders like DWH" .


###  http://www.example.org/muac/ontology/local-moo#Support_System
:Support_System rdf:type owl:Class ;
                rdfs:subClassOf :System_Element ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isDirectPartOf ;
                                  owl:someValuesFrom :Enterprise_System
                                ] ;
                rdfs:comment "A distinct, structured combination of hardware, software, processes, or personnel that interacts with the Operational System during its lifecycle to enable its availability, reliability, security, or continuous improvement. It does not directly produce the primary operational output (e.g., separating aircraft), but it provides the essential environment, data, or services required for the Operational System to do so." ,
                             """Core Criteria for a Support System

Mission Indirectness: If the support system fails entirely, the Operational System doesn't instantly crash mid-operation, but the organization's ability to maintain, deploy, or legally operate that system degrades immediately.

Lifecycle Focus: It often operates on a different rhythm than the real-time operational loop—focusing instead on preparation, maintenance, training, or post-operational analysis.

Shared or Dedicated Infrastructure: It can be internal (e.g., a local test bed) or external (e.g., a commercial satellite communications network provider or third-party weather data feed""" .


###  http://www.example.org/muac/ontology/local-moo#System_Capability
:System_Capability rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :Capability
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :isProvidedBySystemElement ;
                                                                owl:someValuesFrom :Operational_System
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :Capability .


###  http://www.example.org/muac/ontology/local-moo#System_Element
:System_Element rdf:type owl:Class ;
                rdfs:subClassOf :Structural_Element .


###  http://www.example.org/muac/ontology/local-moo#System_Phase
:System_Phase rdf:type owl:Class ;
              rdfs:subClassOf <http://example.org/muac_onto/Phase> .


###  http://www.example.org/muac/ontology/local-moo#System_Process
:System_Process rdf:type owl:Class ;
                rdfs:subClassOf [ owl:intersectionOf ( :Composite_Action_Flow
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :sequencesBlock ;
                                                         owl:someValuesFrom :Function
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :sequencesBlock ;
                                                         owl:allValuesFrom [ owl:intersectionOf ( :Function
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty :isPerformedBySystemElement ;
                                                                                                    owl:someValuesFrom :System_Element
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] .


###  http://www.example.org/muac/ontology/local-moo#Task
:Task rdf:type owl:Class ;
      rdfs:subClassOf :Action_Block ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isResponsibilityOf ;
                        owl:someValuesFrom :Operational_Actor
                      ] .


