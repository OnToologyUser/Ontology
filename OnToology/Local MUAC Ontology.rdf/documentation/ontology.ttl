                                                    owl:someValuesFrom :Aircraft_System
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :Operational_Actor .


###  http://www.example.org/muac/ontology/local-moo#Product
:Product rdf:type owl:Class ;
         rdfs:subClassOf :System_Element ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isDirectPartOf ;
                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                owl:unionOf ( :Product_System
                                                              :Support_System
                                                            )
                                              ]
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasImplementationLevel ;
                           owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                               owl:oneOf [ rdf:type rdf:List ;
                                                           rdf:first "Component" ;
                                                           rdf:rest [ rdf:type rdf:List ;
                                                                      rdf:first "Library" ;
                                                                      rdf:rest [ rdf:type rdf:List ;
                                                                                 rdf:first "Subsystem" ;
                                                                                 rdf:rest rdf:nil
                                                                               ]
                                                                    ]
                                                         ]
                                             ]
                         ] .


